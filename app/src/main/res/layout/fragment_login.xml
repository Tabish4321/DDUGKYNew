<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_gradient">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp_20"
        android:background="@drawable/bg_gradient"
        android:focusableInTouchMode="true"
        android:clickable="true">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_40"
            android:src="@drawable/ddy_logo"
            android:contentDescription="Logo"
            android:adjustViewBounds="true"
            android:maxWidth="@dimen/dp_142"
            android:maxHeight="@dimen/dp_142"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintWidth_percent="0.4"/>

        <!-- Welcome -->
        <TextView
            android:id="@+id/tvLoginTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:fontFamily="@font/avenir_next_bold"
            android:text="Sign In to Continue"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_24"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/imgLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvPasswordLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:fontFamily="@font/avenir_next_medium"
            android:text="Please sign in to your account"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_16"
            android:gravity="center"
            android:maxLines="2"
            app:layout_constraintTop_toBottomOf="@id/tvLoginTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Fields Container -->
        <LinearLayout
            android:id="@+id/llFields"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/dp_80"
            android:minHeight="200dp"
            android:paddingVertical="@dimen/dp_10"
            android:background="@drawable/login_screen_bg"
            android:importantForAutofill="auto"
            app:layout_constraintTop_toBottomOf="@id/tvPasswordLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.9">

            <!-- User label -->
            <TextView
                android:id="@+id/tvUserIdLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_marginEnd="@dimen/dp_20"
                android:fontFamily="@font/avenir_next_demi_bold"
                android:text="Enter User Id"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_16"/>

            <!-- User Input -->
            <EditText
                android:id="@+id/etUserId"
                style="@style/EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_6"
                android:layout_marginBottom="@dimen/dp_10"
                android:minHeight="48dp"
                android:drawableEnd="@drawable/ic_userid"
                android:drawablePadding="@dimen/dp_8"
                android:drawableTint="@color/login_btn"
                android:fontFamily="@font/avenir_next_medium"
                android:hint="Enter User Id"
                android:imeOptions="actionNext"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="@dimen/dp_20"
                android:paddingVertical="@dimen/dp_12"
                android:autofillHints="username"
                android:nextFocusForward="@+id/etPassword"/>

            <!-- Password label -->
            <TextView
                android:id="@+id/tvUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_marginEnd="@dimen/dp_20"
                android:fontFamily="@font/avenir_next_demi_bold"
                android:text="Enter Account Password"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_16"/>

            <!-- Password Input -->
            <EditText
                android:id="@+id/etPassword"
                style="@style/EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_6"
                android:minHeight="48dp"
                android:drawableStart="@null"
                android:drawableEnd="@drawable/ic_passwordtoggle"
                android:drawablePadding="@dimen/dp_8"
                android:drawableTint="@color/login_btn"
                android:fontFamily="@font/avenir_next_medium"
                android:hint="Enter Password"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:paddingHorizontal="@dimen/dp_20"
                android:paddingVertical="@dimen/dp_12"
                android:autofillHints="password"/>

            <!-- Forgot Password -->
            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_20"
                android:fontFamily="@font/avenir_next_bold"
                android:text="Forgot password?"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_15"
                android:visibility="gone"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/dp_30"
            android:layout_marginBottom="@dimen/dp_20"
            android:padding="@dimen/dp_10"
            android:text="Login"
            android:textSize="15sp"
            android:backgroundTint="@color/login_btn"
            android:fontFamily="@font/avenir_next_medium"
            app:layout_constraintTop_toBottomOf="@id/llFields"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:filterTouchesWhenObscured="true"
            />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#808080"
            android:fontFamily="@font/avenir_next_regular"
            app:layout_constraintTop_toBottomOf="@id/btnLogin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />



