<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="10dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="4dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="2dp"
    card_view:cardUseCompatPadding="false"
    tools:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. PIA Name Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="PIA Name"
                android:background="@drawable/bg_circle_icon"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/training_center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Applicant Industry Name"
                    android:textColor="@color/color_sub_text"
                    android:textSize="11sp"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/piaName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:maxLines="2"
                    android:textColor="@color/color_text"
                    android:textSize="15sp"
                    tools:text="DDU-GKY Training Partner Pvt Ltd" />

            </LinearLayout>

        </LinearLayout>

        <!-- 2. PRN No Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="PRN"
                android:background="@drawable/bg_circle_icon"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/sanction" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRN No"
                    android:textColor="@color/color_sub_text"
                    android:textSize="11sp"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/prnNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/avenir_next_medium"
                    android:maxLines="1"
                    android:textColor="@color/color_text"
                    android:textSize="14sp"
                    tools:text="PRN/2025/00125" />

            </LinearLayout>

        </LinearLayout>

        <!-- 3. Address Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Address"
                android:background="@drawable/bg_circle_icon"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_location" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Address"
                    android:textColor="@color/color_sub_text"
                    android:textSize="11sp"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/avenir_next_medium"
                    android:maxLines="3"
                    android:textColor="@color/color_text"
                    android:textSize="14sp"
                    tools:text="Village XYZ, Main Road, Near Bus Stand, District ABC" />

            </LinearLayout>

        </LinearLayout>

        <!-- 4. District Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="District"
                android:background="@drawable/bg_circle_icon"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_district" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="District"
                    android:textColor="@color/color_sub_text"
                    android:textSize="11sp"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/districtName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/avenir_next_medium"
                    android:maxLines="2"
                    android:textColor="@color/color_text"
                    android:textSize="14sp"
                    tools:text="Bhopal" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>