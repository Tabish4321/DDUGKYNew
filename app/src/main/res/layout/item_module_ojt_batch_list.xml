<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="5dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/charcoal_gray"
    android:backgroundTint="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@android:color/white">

        <!-- ================= OJT Name ================= -->
        <TextView
            android:id="@+id/tvOJTName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ojt_name"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/OJTName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/charcoal_gray"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/tvOJTName"
            app:layout_constraintEnd_toStartOf="@id/imgExpand"
            app:layout_constraintTop_toTopOf="@id/tvOJTName"/>

        <!-- ================= No of Candidates ================= -->
        <TextView
            android:id="@+id/tvNo_of_Candidates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_of_candidates"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/OJTName"/>

        <TextView
            android:id="@+id/No_of_Candidates"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/charcoal_gray"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/tvNo_of_Candidates"
            app:layout_constraintEnd_toStartOf="@id/imgExpand"
            app:layout_constraintTop_toTopOf="@id/tvNo_of_Candidates"/>

        <!-- ================= Completed OJT ================= -->
        <TextView
            android:id="@+id/tvNumber_of_completed_ojt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/number_of_completed_ojt"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNo_of_Candidates"/>

        <TextView
            android:id="@+id/Number_of_completed_ojt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/charcoal_gray"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/tvNumber_of_completed_ojt"
            app:layout_constraintEnd_toStartOf="@id/imgExpand"
            app:layout_constraintTop_toTopOf="@id/tvNumber_of_completed_ojt"/>

        <!-- ================= Pending OJT ================= -->
        <TextView
            android:id="@+id/tvnumber_of_pending_ojt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/number_of_pending_ojt"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNumber_of_completed_ojt"/>

        <TextView
            android:id="@+id/number_of_pending_ojt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/charcoal_gray"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/tvnumber_of_pending_ojt"
            app:layout_constraintEnd_toStartOf="@id/imgExpand"
            app:layout_constraintTop_toTopOf="@id/tvnumber_of_pending_ojt"/>

        <!-- ================= Expand Arrow ================= -->
        <ImageView
            android:id="@+id/imgExpand"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/outline_arrow_forward"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/tvnumber_of_pending_ojt"
            app:layout_constraintVertical_bias="0.5"/>

        <!-- ================= Child RecyclerView ================= -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChildItems"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tvnumber_of_pending_ojt"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>




