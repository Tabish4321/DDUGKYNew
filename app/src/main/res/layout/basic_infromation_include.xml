<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="@dimen/dp_15"
        android:layout_marginBottom="@dimen/dp_16"
        android:background="@color/white"
        app:cardCornerRadius="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/headerTCBasicInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/dp_12">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/baseline_info_24"
                    android:drawablePadding="@dimen/dp_8"
                    android:gravity="center_vertical"
                    android:text="@string/basic_information"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivToggleTCBasicInfo"
                    android:layout_width="20dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_dropdown_arrow" />

            </LinearLayout>

            <!-- Content -->
            <LinearLayout
                android:id="@+id/layoutTCBasicInfoContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dp_10"
                android:paddingTop="@dimen/dp_8"
                android:visibility="gone">

                <!-- Facility Name -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/residential_facility_name"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:hint="@string/residential_facility_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFacilityName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Facility Type -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/residential_facility_type"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />



                <Spinner
                    android:id="@+id/spinnerFacilityType"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/spinner_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />


                <!-- House No -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/house_no"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:hint="@string/house_no">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHouseNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Street -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/street"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:hint="@string/street">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStreet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Landmark -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/landmark"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:hint="@string/landmark">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLandmark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- State/UT -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/state_ut_tc_label"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />



                <Spinner
                    android:id="@+id/spinnerState"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/spinner_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>


                <!-- District -->
                <TextView
                    android:id="@+id/tvTrainDescAcademia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/district_tc"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />


                <Spinner
                    android:id="@+id/spinnerDistrict"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/spinner_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>


                <!--Select Type-->
                <TextView
                    android:id="@+id/tvSelectType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/select_type"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />



                <Spinner
                    android:id="@+id/spinnerSelectType"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/spinner_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>


                <LinearLayout
                    android:id="@+id/urban_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!--                 ULB   -->
                    <TextView
                        android:id="@+id/tvSelectULB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_4"
                        android:layout_marginTop="@dimen/dp_10"
                        android:fontFamily="@font/avenir_next_semi_bold"
                        android:text="@string/select_ULB"
                        android:textColor="@color/color_dark_green"
                        android:textSize="@dimen/sp_16" />


                    <Spinner
                        android:id="@+id/spinnerSelectULB"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/spinner_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>


                    <!--Ward -->


                    <TextView
                        android:id="@+id/tvSelectWard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_4"
                        android:layout_marginTop="@dimen/dp_10"
                        android:fontFamily="@font/avenir_next_semi_bold"
                        android:text="@string/select_Ward"
                        android:textColor="@color/color_dark_green"
                        android:textSize="@dimen/sp_16" />



                    <Spinner
                        android:id="@+id/spinnerSelectWard"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/spinner_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/village_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Block -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_4"
                        android:layout_marginTop="@dimen/dp_10"
                        android:fontFamily="@font/avenir_next_semi_bold"
                        android:text="@string/block"
                        android:textColor="@color/color_dark_green"
                        android:textSize="@dimen/sp_16" />


                    <Spinner
                        android:id="@+id/spinnerBlock"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/spinner_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>


                    <!-- Gram Panchayat -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_4"
                        android:layout_marginTop="@dimen/dp_10"
                        android:fontFamily="@font/avenir_next_semi_bold"
                        android:text="@string/gram_panchayat"
                        android:textColor="@color/color_dark_green"
                        android:textSize="@dimen/sp_16" />



                    <Spinner
                        android:id="@+id/spinnerGp"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/spinner_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>


                    <!-- Village/Ward No -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_4"
                        android:layout_marginTop="@dimen/dp_10"
                        android:fontFamily="@font/avenir_next_semi_bold"
                        android:text="@string/village_no"
                        android:textColor="@color/color_dark_green"
                        android:textSize="@dimen/sp_16" />


                    <Spinner
                        android:id="@+id/spinnerVillage"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/spinner_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>


                </LinearLayout>

                <!-- Police Station -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/police_station"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:hint="@string/police_station">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPoliceStation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Pincode -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/pincode"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:hint="@string/pincode">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPinCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="6" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Latitude and Longitude -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/latitude_and_longitude"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <TextView
                    android:id="@+id/tvLatLang"
                    style="@style/EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:background="@drawable/edittext_background"
                    android:padding="12dp"
                    android:text="@string/latitude_and_longitude"
                    android:textColor="@android:color/black"
                    android:textSize="16sp" />

                <!-- Mobile No -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/mobile_no"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:hint="@string/mobile_no">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="10" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Phone No with STD Code -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/residential_facility_phone_no_with_std_code"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:hint="@string/residential_facility_phone_no_with_std_code">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email ID -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/email_id"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:hint="@string/email_id">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Type of Area -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/type_of_area1"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />


                <Spinner
                    android:id="@+id/spinnerTypeOfArea"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/spinner_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>



                <!-- Category of TC Location -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/category_of_tc_location_x_y_z_any_other_area"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />


                <Spinner
                    android:id="@+id/spinnerCatOfTCLocation"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/spinner_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>


                <!-- Distance from Bus Stand -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/approximate_distance_from_a_prominent_bus_stand_in_mtrs"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:hint="@string/approximate_distance_from_a_prominent_bus_stand_in_mtrs">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDistanceFromBusStand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Distance from Auto Stand -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/approximate_distance_from_an_auto_stand_in_mtrs"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:hint="@string/approximate_distance_from_an_auto_stand_in_mtrs">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDistanceFromAutoStand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Distance from Railway Station -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/approximate_distance_from_a_prominent_railway_station_in_mtrs"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:hint="@string/approximate_distance_from_a_prominent_railway_station_in_mtrs">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDistanceFromRailwayStand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Distance from Training Centre to Residential Centre -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/distance_from_the_training_centre_to_residential_centre_in_kms"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:hint="@string/distance_from_the_training_centre_to_residential_centre_in_kms">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDistanceFromTrainingToResidentialCentre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Pickup and Drop Facility -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/availability_of_pick_up_and_drop_facility"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />


                <Spinner
                    android:id="@+id/spinnerPickupAndDropFacility"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/spinner_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>


                <!-- Warden Details Section Header -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:gravity="center_horizontal"
                    android:text="Warden Details"
                    android:textColor="@color/teal"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Warden Name -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/warden_s_name"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:hint="@string/warden_s_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWardenName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Warden Gender -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/warden_gender"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <Spinner
                    android:id="@+id/spinnerWardenGender"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/spinner_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>

                <!-- Warden Employee ID -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/warden_employee_id"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:hint="@string/warden_employee_id">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWardenEmpID"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Warden Address -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/warden_address"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:hint="@string/warden_address">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWardenAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Warden Email ID -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/warden_email_id"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:hint="@string/warden_email_id">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWardenEmailId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Warden Mobile No -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:text="@string/warden_mobile_no"
                    android:textColor="@color/color_dark_green"
                    android:textSize="@dimen/sp_16" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:hint="@string/warden_mobile_no">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWardenMobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="10" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Police Verification Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/avenir_next_semi_bold"
                        android:text="@string/police_verification_status"
                        android:textColor="@color/color_dark_green"
                        android:textSize="@dimen/sp_16" />

                    <Button
                        android:id="@+id/btnUploadPoliceVerificationDoc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload"
                        android:minHeight="48dp" />

                    <ImageView
                        android:id="@+id/ivPoliceVerificationDocPreview"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Appointment Letter -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/avenir_next_semi_bold"
                        android:text="@string/appointment_letter"
                        android:textColor="@color/color_dark_green"
                        android:textSize="@dimen/sp_16" />

                    <Button
                        android:id="@+id/btnUploadAppointmentLetterDoc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload"
                        android:minHeight="48dp" />

                    <ImageView
                        android:id="@+id/ivAppointmentLetterDocPreview"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Submit Button -->
                <Button
                    android:id="@+id/btnSubmitBasicInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginBottom="@dimen/dp_8"
                    android:backgroundTint="?attr/colorPrimary"
                    android:minHeight="48dp"
                    android:text="Submit"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>