<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="4dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/login_btn"
    app:strokeWidth="0.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@color/white"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="@color/colorPrimarynew"
            android:layout_marginEnd="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvFormName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Form Name"
            android:fontFamily="@font/sf_pro_rounded_semibold"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:letterSpacing="0.0"
            android:lineHeight="24sp" />

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/outline_arrow_forward"
            android:tint="@color/black" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>