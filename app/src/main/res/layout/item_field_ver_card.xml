<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    card_view:cardCornerRadius="14dp"
    card_view:cardElevation="1dp"
    card_view:cardBackgroundColor="#FFFFFF"
    card_view:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Accent top strip ────────────────────────────────── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/color_dark_blue"
            android:alpha="0.12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── Header: step indicator + title ─────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Left accent bar -->
                <View
                    android:layout_width="3dp"
                    android:layout_height="36dp"
                    android:background="@color/color_dark_blue"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tv_req_title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/field_ver_industry_existence"
                    android:textSize="14sp"
                    android:fontFamily="@font/avenir_next_semi_bold"
                    android:textColor="#111827"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="3"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- ── Divider ─────────────────────────────────────── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:background="#F0F2F5" />

            <!-- ── Verification note ───────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <!-- Info dot -->
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="#6B7280" />

                <TextView
                    android:id="@+id/tv_verification"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/field_ver_valid_govt_note_doc"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/avenir_next_medium"
                    android:textColor="#6B7280"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="4"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- ── Chip group (documents / actions) ───────────── -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipgroup_documents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleLine="false"
                app:chipSpacing="6dp"
                android:layout_marginTop="14dp"
                />

            <!-- ── Remarks group ───────────────────────────────── -->
            <LinearLayout
                android:id="@+id/remarkGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="14dp">

                <!-- Label row with asterisk badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvRemarkLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Remarks"
                        android:textColor="#111827"
                        android:fontFamily="@font/avenir_next_semi_bold"
                        android:textSize="12.5sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05" />

                    <!-- Required badge -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Required"
                        android:textSize="10sp"
                        android:textColor="@color/color_dark_blue"
                        android:fontFamily="@font/avenir_next_semi_bold"
                        android:background="@drawable/bg_chip_blue_outline"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp" />

                </LinearLayout>

                <EditText
                    android:id="@+id/etSectionRemark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Type your field remarks here..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2"
                    android:maxLines="5"
                    android:background="@drawable/edittext_background"
                    android:padding="12dp"
                    android:layout_marginTop="8dp"
                    android:textColor="#111827"
                    android:textColorHint="#9CA3AF"
                    android:textSize="14sp"
                    android:fontFamily="@font/avenir_next_medium"
                    android:scrollbars="vertical" />

            </LinearLayout>

            <!-- ── Photo preview pair ──────────────────────────── -->
            <LinearLayout
                android:id="@+id/imageGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginTop="14dp"
                android:gravity="start">

                <!-- Preview 1 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/ivCardPreview"
                    xmlns:cv="http://schemas.android.com/apk/res-auto"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="8dp"
                    cv:cardCornerRadius="8dp"
                    cv:cardElevation="1dp">

                    <ImageView
                        android:id="@+id/ivPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="#E5E7EB"
                        android:visibility="gone" />

                </androidx.cardview.widget.CardView>

                <!-- Preview 2 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/ivCardPreview1"

                    xmlns:cv="http://schemas.android.com/apk/res-auto"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    cv:cardCornerRadius="8dp"
                    cv:cardElevation="1dp">

                    <ImageView
                        android:id="@+id/ivPreview1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="#E5E7EB"
                        android:visibility="gone" />

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>