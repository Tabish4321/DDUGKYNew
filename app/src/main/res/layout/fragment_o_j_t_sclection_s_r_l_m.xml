                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                app:indicatorColor="@color/login_btn"
                app:trackColor="@color/white_brilliant"
                app:indicatorSize="64dp"
                app:trackThickness="6dp"
                android:visibility="gone" />




            <TextView
                android:id="@+id/tvPiaType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_30"
                android:layout_marginTop="@dimen/dp_10"
                android:fontFamily="@font/avenir_next_demi_bold"
                android:text="@string/select_pia_name_sanctionOrderNo"
                android:textColor="@color/color_dark_green"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvCareOfName" />
            <SearchView
                android:id="@+id/searchViewPiaName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:queryHint="@string/search_pia_name"
                android:iconifiedByDefault="false"
                android:focusable="false"
                android:focusableInTouchMode="false"

                android:textColor="@color/color_dark_green"
                android:textSize="15sp"
                tools:ignore="LabelFor" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tPiaName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_30"
                android:layout_marginEnd="@dimen/dp_30"
                android:fontFamily="@font/avenir_next_demi_bold"
                android:hint="@string/pia_name_ojt"
                android:padding="1dp"
                android:textColorHint="@color/color_dark_green"
                app:boxStrokeColor="@color/color_dark_green"
                app:layout_constraintStart_toStartOf="@+id/tvFollowType"
                app:layout_constraintTop_toBottomOf="@+id/tvFollowType">




                <AutoCompleteTextView
                    android:id="@+id/OjtspinnerPiaName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:inputType="none"
                    android:textColor="@color/color_dark_green"
                    android:textSize="15sp"
                    tools:ignore="LabelFor" />

            </com.google.android.material.textfield.TextInputLayout>



























