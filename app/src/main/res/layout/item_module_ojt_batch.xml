<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="6dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/charcoal_gray">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- ===== Batch ID Label ===== -->
        <TextView
            android:id="@+id/tvBatchId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/batch_reg_no"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- ===== Batch ID Value ===== -->
        <TextView
            android:id="@+id/batchRegNo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/charcoal_gray"
            android:textSize="14sp"
            android:textAlignment="viewStart"
            android:maxLines="3"
            android:ellipsize="end"
            tools:text="123456789999999999999"
            app:layout_constraintStart_toEndOf="@id/tvBatchId"
            app:layout_constraintEnd_toStartOf="@id/imgExpand"
            app:layout_constraintTop_toTopOf="@id/tvBatchId"/>

        <!-- ===== Trade Name Label ===== -->
        <TextView
            android:id="@+id/tvBatchName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trade_name"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBatchId"/>

        <!-- ===== Trade Name Value ===== -->
        <TextView
            android:id="@+id/tvBatch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/charcoal_gray"
            android:textSize="14sp"
            android:textAlignment="viewStart"
            android:maxLines="3"
            android:ellipsize="end"
            tools:text="Very Long Trade Name That Should Automatically Adjust"
            app:layout_constraintStart_toEndOf="@id/tvBatchName"
            app:layout_constraintEnd_toStartOf="@id/imgExpand"
            app:layout_constraintTop_toTopOf="@id/tvBatchName"/>

        <!-- ===== OJT Label ===== -->
        <TextView
            android:id="@+id/tvOjt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/total_ojt_on_batch"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBatch"/>

        <!-- ===== OJT Value ===== -->
        <TextView
            android:id="@+id/tabMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/charcoal_gray"
            android:textSize="14sp"
            android:textAlignment="viewStart"
            tools:text="250"
            app:layout_constraintStart_toEndOf="@id/tvOjt"
            app:layout_constraintEnd_toStartOf="@id/imgExpand"
            app:layout_constraintTop_toTopOf="@id/tvOjt"/>

        <!-- ===== Expand Arrow (Right + Vertically Centered) ===== -->
        <ImageView
            android:id="@+id/imgExpand"
            android:layout_width="24dp"
            android:layout_height="24dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.5"/>
<!--        android:src="@drawable/outline_arrow_forward"-->

        <!-- ===== Child RecyclerView ===== -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChildItems"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tvOjt"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>




