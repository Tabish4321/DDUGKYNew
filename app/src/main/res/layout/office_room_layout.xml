<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/dp_1">

        <!-- Header Card with Gradient -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/headerCard"
            android:layout_width="0dp"
            android:layout_height="60dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_15"
                android:background="@drawable/nav_header_gradient">

                <!-- Title with Icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/backButton"
                        android:layout_width="@dimen/dp_40"
                        android:layout_height="@dimen/dp_40"
                        android:layout_marginEnd="@dimen/dp_12"
                        android:backgroundTint="@color/color_dark_green"
                        android:padding="@dimen/dp_5"
                        android:scaleType="centerInside"
                        android:src="@drawable/back_arrow"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CornerFull" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_40"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/office_room"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp_20"
                        android:textStyle="bold"
                        tools:text="Office Room" />



                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Content Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/contentCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerCard">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/trainingInfraFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/dp_20">

                <!-- Office Room Photograph -->
                <LinearLayout
                    android:id="@+id/officeRoomPhotoContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Label Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/dp_4">

                        <ImageView
                            android:layout_width="@dimen/dp_24"
                            android:layout_height="@dimen/dp_24"
                            android:layout_marginEnd="@dimen/dp_12"
                            android:src="@drawable/office_room"
                            android:tint="@color/color_dark_green" />

                        <TextView
                            android:id="@+id/labelOfficeRoomPhoto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/office_room_photograph"
                            android:textColor="@color/color_dark_green"
                            android:textSize="16sp"
                            android:fontFamily="@font/avenir_next_semi_bold" />

                    </LinearLayout>

                    <!-- Value Row - Status and View aligned horizontally -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/dp_30"
                        android:paddingVertical="@dimen/dp_5">

                        <!-- Status Badge -->
                        <TextView
                            android:id="@+id/yesNoOfficeRoomPhoto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp_20"
                            android:background="@drawable/rounded_status_bg"
                            android:paddingHorizontal="@dimen/dp_20"
                            android:paddingVertical="@dimen/dp_6"
                            android:text="Yes"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                        <!-- View Option -->
                        <TextView
                            android:id="@+id/valueOfficeRoomPhoto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/dp_5"
                            android:drawableStart="@drawable/ic_view"
                            android:paddingVertical="@dimen/dp_5"
                            android:text="@string/view"
                            android:textColor="@color/color_dark_blue"
                            android:textSize="14sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:id="@+id/divider1"
                    style="@style/DividerStyle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/officeRoomPhotoContainer" />

                <!-- Type of Roof -->
                <LinearLayout
                    android:id="@+id/roofTypeContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider1">

                    <!-- Label Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/dp_4">

                        <ImageView
                            android:layout_width="@dimen/dp_24"
                            android:layout_height="@dimen/dp_24"
                            android:layout_marginEnd="@dimen/dp_12"
                            android:src="@drawable/ic_roof"
                            android:tint="@color/color_dark_green" />

                        <TextView
                            android:id="@+id/labelRoofType"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/type_of_roof"
                            android:textColor="@color/color_dark_green"
                            android:textSize="16sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                    </LinearLayout>

                    <!-- Value Row - Status and View aligned horizontally -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/dp_30"
                        android:paddingVertical="@dimen/dp_5">

                        <TextView
                            android:id="@+id/yesNoRoofType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp_20"
                            android:background="@drawable/rounded_status_bg"
                            android:paddingHorizontal="@dimen/dp_20"
                            android:paddingVertical="@dimen/dp_6"
                            android:text="Yes"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                        <TextView
                            android:id="@+id/valueRoofType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/dp_5"
                            android:drawableStart="@drawable/ic_view"
                            android:paddingVertical="@dimen/dp_5"
                            android:text="@string/view"
                            android:textColor="@color/color_dark_blue"
                            android:textSize="14sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:id="@+id/divider2"
                    style="@style/DividerStyle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/roofTypeContainer" />

                <!-- False Ceiling Provided -->
                <LinearLayout
                    android:id="@+id/falseCeilingContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/dp_4">

                        <ImageView
                            android:layout_width="@dimen/dp_24"
                            android:layout_height="@dimen/dp_24"
                            android:layout_marginEnd="@dimen/dp_12"
                            android:src="@drawable/ic_walls"
                            android:tint="@color/color_dark_green" />

                        <TextView
                            android:id="@+id/labelFalseCeiling"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/false_ceiling_provided"
                            android:textColor="@color/color_dark_green"
                            android:textSize="16sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                    </LinearLayout>

                    <!-- Value Row - Status and View aligned horizontally -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/dp_30"
                        android:paddingVertical="@dimen/dp_5">

                        <TextView
                            android:id="@+id/yesNoFalseCeiling"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp_20"
                            android:background="@drawable/rounded_status_bg"
                            android:paddingHorizontal="@dimen/dp_20"
                            android:paddingVertical="@dimen/dp_6"
                            android:text="Yes"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                        <TextView
                            android:id="@+id/valueFalseCeiling"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/dp_5"
                            android:drawableStart="@drawable/ic_view"
                            android:paddingVertical="@dimen/dp_5"
                            android:text="@string/view"
                            android:textColor="@color/color_dark_blue"
                            android:textSize="14sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:id="@+id/divider3"
                    style="@style/DividerStyle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/falseCeilingContainer" />

                <!-- Height of Ceiling -->
                <LinearLayout
                    android:id="@+id/ceilingHeightContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider3">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/dp_4">

                        <ImageView
                            android:layout_width="@dimen/dp_24"
                            android:layout_height="@dimen/dp_24"
                            android:layout_marginEnd="@dimen/dp_12"
                            android:src="@drawable/ic_special"
                            android:tint="@color/color_dark_green" />

                        <TextView
                            android:id="@+id/labelCeilingHeight"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/height_of_ceiling_in_ft"
                            android:textColor="@color/color_dark_green"
                            android:textSize="16sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                    </LinearLayout>

                    <!-- Value Row - Status and View aligned horizontally -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/dp_30"
                        android:paddingVertical="@dimen/dp_5">

                        <TextView
                            android:id="@+id/yesNoCeilingHeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp_20"
                            android:background="@drawable/rounded_status_bg"
                            android:paddingHorizontal="@dimen/dp_20"
                            android:paddingVertical="@dimen/dp_6"
                            android:text="24"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                        <TextView
                            android:id="@+id/valueCeilingHeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/dp_5"
                            android:drawableStart="@drawable/ic_view"
                            android:paddingVertical="@dimen/dp_5"
                            android:text="@string/view"
                            android:textColor="@color/color_dark_blue"
                            android:textSize="14sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:id="@+id/divider4"
                    style="@style/DividerStyle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ceilingHeightContainer" />

                <!-- Storage Place for Securing Documents -->
                <LinearLayout
                    android:id="@+id/storageContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/dp_4">

                        <ImageView
                            android:layout_width="@dimen/dp_24"
                            android:layout_height="@dimen/dp_24"
                            android:layout_marginEnd="@dimen/dp_12"
                            android:src="@drawable/file"
                            android:tint="@color/color_dark_green" />

                        <TextView
                            android:id="@+id/labelStorage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/storage_place_for_securing_documents"
                            android:textColor="@color/color_dark_green"
                            android:textSize="16sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                    </LinearLayout>

                    <!-- Value Row - Status and View aligned horizontally -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/dp_30"
                        android:paddingVertical="@dimen/dp_5">

                        <TextView
                            android:id="@+id/yesNoStorage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp_20"
                            android:background="@drawable/rounded_status_bg"
                            android:paddingHorizontal="@dimen/dp_20"
                            android:paddingVertical="@dimen/dp_6"
                            android:text="Yes"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                        <TextView
                            android:id="@+id/valueStorage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/dp_5"
                            android:drawableStart="@drawable/ic_view"
                            android:paddingVertical="@dimen/dp_5"
                            android:text="@string/view"
                            android:textColor="@color/color_dark_blue"
                            android:textSize="14sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:id="@+id/divider5"
                    style="@style/DividerStyle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/storageContainer" />

                <!-- Office Table -->
                <LinearLayout
                    android:id="@+id/officeTableContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/dp_4">

                        <ImageView
                            android:layout_width="@dimen/dp_24"
                            android:layout_height="@dimen/dp_24"
                            android:layout_marginEnd="@dimen/dp_12"
                            android:src="@drawable/office_room"
                            android:tint="@color/color_dark_green" />

                        <TextView
                            android:id="@+id/labelOfficeTable"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/an_office_table_in_no"
                            android:textColor="@color/color_dark_green"
                            android:textSize="16sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                    </LinearLayout>

                    <!-- Value Row - Status and View aligned horizontally -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/dp_30"
                        android:paddingVertical="@dimen/dp_5">

                        <TextView
                            android:id="@+id/yesNoOfficeTable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp_20"
                            android:background="@drawable/rounded_status_bg"
                            android:paddingHorizontal="@dimen/dp_20"
                            android:paddingVertical="@dimen/dp_6"
                            android:text="23"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                        <TextView
                            android:id="@+id/valueOfficeTable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/dp_5"
                            android:drawableStart="@drawable/ic_view"
                            android:paddingVertical="@dimen/dp_5"
                            android:text="@string/view"
                            android:textColor="@color/color_dark_blue"
                            android:textSize="14sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:id="@+id/divider6"
                    style="@style/DividerStyle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/officeTableContainer" />

                <!-- Chairs -->
                <LinearLayout
                    android:id="@+id/chairsContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider6">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/dp_4">

                        <ImageView
                            android:layout_width="@dimen/dp_24"
                            android:layout_height="@dimen/dp_24"
                            android:layout_marginEnd="@dimen/dp_12"
                            android:src="@drawable/chair"
                            android:tint="@color/color_dark_green" />

                        <TextView
                            android:id="@+id/labelChairs"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/chairs_in_no"
                            android:textColor="@color/color_dark_green"
                            android:textSize="16sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                    </LinearLayout>

                    <!-- Value Row - Status and View aligned horizontally -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/dp_30"
                        android:paddingVertical="@dimen/dp_5">

                        <TextView
                            android:id="@+id/yesNoChairs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp_20"
                            android:background="@drawable/rounded_status_bg"
                            android:paddingHorizontal="@dimen/dp_20"
                            android:paddingVertical="@dimen/dp_6"
                            android:text="23"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                        <TextView
                            android:id="@+id/valueChairs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/dp_5"
                            android:drawableStart="@drawable/ic_view"
                            android:paddingVertical="@dimen/dp_5"
                            android:text="@string/view"
                            android:textColor="@color/color_dark_blue"
                            android:textSize="14sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:id="@+id/divider7"
                    style="@style/DividerStyle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/chairsContainer" />

                <!-- Table for Office Computer -->
                <LinearLayout
                    android:id="@+id/computerTableContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider7">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/dp_4">

                        <ImageView
                            android:layout_width="@dimen/dp_24"
                            android:layout_height="@dimen/dp_24"
                            android:layout_marginEnd="@dimen/dp_12"
                            android:src="@drawable/table"
                            android:tint="@color/color_dark_green" />

                        <TextView
                            android:id="@+id/labelComputerTable"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/table_for_office_computer"
                            android:textColor="@color/color_dark_green"
                            android:textSize="16sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                    </LinearLayout>

                    <!-- Value Row - Status and View aligned horizontally -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/dp_30"
                        android:paddingVertical="@dimen/dp_5">

                        <TextView
                            android:id="@+id/yesNoComputerTable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp_20"
                            android:background="@drawable/rounded_status_bg"
                            android:paddingHorizontal="@dimen/dp_20"
                            android:paddingVertical="@dimen/dp_6"
                            android:text="Yes"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:fontFamily="@font/avenir_next_semi_bold"/>

                        <TextView
                            android:id="@+id/valueComputerTable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/dp_5"
                            android:drawableStart="@drawable/ic_view"
                            android:paddingVertical="@dimen/dp_5"
                            android:text="@string/view"
                            android:textColor="@color/color_dark_blue"
                            android:textSize="14sp"
