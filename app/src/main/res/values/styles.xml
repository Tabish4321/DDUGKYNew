<resources>


    <style name="CustomCircleShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

<!--    <style name="CustomRectangleShape">-->
<!--        <item name="cornerFamily">rounded</item>-->
<!--        <item name="cornerSize">12%</item>-->
<!--    </style>-->
    <style name="CustomChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipStrokeColor">@color/color_dark_green</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipBackgroundColor">@color/white</item>
        <item name="checkedIconVisible">true</item>
        <item name="chipCornerRadius">8dp</item>
    </style>
    <style name="FullScreenDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="BottomSheetDialogTheme" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="CustomBottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/RoundedTopCorners</item>
    </style>

    <style name="RoundedTopCorners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="smallButton1" parent="Base.Theme.Ddugky">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/shape_rectangle_green</item>
        <item name="android:fontFamily">@font/avenir_next_demi_bold</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingVertical">@dimen/dp_10</item>
        <item name="android:paddingStart">@dimen/dp_10</item>
        <item name="android:paddingEnd">@dimen/dp_10</item>
    </style>

    <style name="NavItemTextAppearance" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/avenir_next_medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="ModernDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog.Centered">
        <item name="materialAlertDialogTitleTextStyle">@style/ModernDialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/ModernDialogBody</item>

    </style>

    <style name="ModernDialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="fontFamily">@font/avenir_next_semi_bold</item>
    </style>

    <style name="ModernDialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="fontFamily">@font/avenir_next_regular</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>


        <!-- RoundedMediumShape - Used for TextInputLayouts and buttons -->
        <style name="RoundedMediumShape" parent="">
            <item name="cornerFamily">rounded</item>
            <item name="cornerSize">8dp</item>
            <item name="cornerSizeTopLeft">8dp</item>
            <item name="cornerSizeTopRight">8dp</item>
            <item name="cornerSizeBottomLeft">8dp</item>
            <item name="cornerSizeBottomRight">8dp</item>
        </style>

        <!-- CircleShape - Used for icons and avatars -->
        <style name="CircleShape" parent="">
            <item name="cornerFamily">rounded</item>
            <item name="cornerSize">50%</item>
        </style>

        <!-- RoundedLargeShape - Used for cards and larger containers -->
        <style name="RoundedLargeShape" parent="">
            <item name="cornerFamily">rounded</item>
            <item name="cornerSize">12dp</item>
            <item name="cornerSizeTopLeft">12dp</item>
            <item name="cornerSizeTopRight">12dp</item>
            <item name="cornerSizeBottomLeft">12dp</item>
            <item name="cornerSizeBottomRight">12dp</item>
        </style>

        <!-- CustomRectangleShape - For logo container -->
        <style name="CustomRectangleShape" parent="">
            <item name="cornerFamily">rounded</item>
            <item name="cornerSize">4dp</item>
            <item name="cornerSizeTopLeft">4dp</item>
            <item name="cornerSizeTopRight">4dp</item>
            <item name="cornerSizeBottomLeft">4dp</item>
            <item name="cornerSizeBottomRight">4dp</item>
        </style>

        <!-- PillShape - For tab indicators or special buttons -->
        <style name="PillShape" parent="">
            <item name="cornerFamily">rounded</item>
            <item name="cornerSize">50%</item>
        </style>

    <style name="ThemeOverlay.App.RoundedDialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="dialogCornerRadius">28dp</item>
    </style>


    <style name="DividerStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginVertical">8dp</item>
        <item name="android:background">@color/color_light_grey</item>
    </style>

    <style name="ShapeAppearanceOverlay.CornerFull" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="FullWidthMaterialDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="FullScreenDialogTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>


</resources>